@baseUrl = http://localhost:5254
@aliceUsername = alice
@alicePassword = AliceDemo123!
@bobUsername = bob
@bobPassword = BobDemo123!

### API root
GET {{baseUrl}}/

### Protected route without a token (expect 401)
GET {{baseUrl}}/notes

### Log in as Alice
# @name loginAlice
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{aliceUsername}}",
  "password": "{{alicePassword}}"
}

### Create Alice's note
# @name createNote
POST {{baseUrl}}/notes
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwidXNlcklkIjoiMSIsIm5hbWUiOiJhbGljZSIsImlhdCI6MTc5NTc5NjE0OSwibmJmIjoxNzk1Nzk2MTQ5LCJleHAiOjE3OTU3OTYyNjksImlzcyI6Ik5vdGVzQXBwIn0.nFTmDANfFfhPvY6VosXtTLbqL_bYsTiYvcJJKppvHMw
Content-Type: application/json

{
  "title": "Alice's private note",
  "content": "Only Alice should be able to read, update, or delete this note."
}

### List Alice's notes
GET {{baseUrl}}/notes
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyIiwidXNlcklkIjoiMiIsIm5hbWUiOiJib2IiLCJpYXQiOjE3OTU3OTYxNzksIm5iZiI6MTc5NTc5NjE3OSwiZXhwIjoxNzk1Nzk2Mjk5LCJpc3MiOiJOb3Rlc0FwcCJ9.r3ATkqrtO6aMv7uCEawlEA92m_UukayL1g7uGYejyVQ

### Log in as Bob
# @name loginBob
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{bobUsername}}",
  "password": "{{bobPassword}}"
}


